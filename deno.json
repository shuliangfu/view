{
  "name": "@dreamer/view",
  "version": "3.0.1",
  "license": "Apache-2.0",
  "description": "High-performance reactive UI framework inspired by Solid.js. Features fine-grained reactivity, no virtual DOM, compiler-optimized DOM/SSR paths, and built-in HMR.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuliangfu/view.git"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./cli": "./src/cli.ts",
    "./setup": "./src/setup.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./portal": "./src/runtime/portal.ts",
    "./compiler": "./src/compiler/mod.ts",
    "./optimize": "./src/optimize.ts",
    "./ssr": "./src/runtime/server.ts",
    "./reactivity": "./src/reactivity/mod.ts",
    "./scheduler": "./src/scheduler/mod.ts",
    "./router": "./src/router.ts",
    "./form": "./src/form.ts",
    "./resource": "./src/resource.ts",
    "./control-flow": "./src/control-flow.ts",
    "./csr": "./src/csr.ts",
    "./devtools": "./src/devtools.ts",
    "./devtools/overlay": "./src/devtools/overlay.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/tests/**"
    ]
  },
  "tasks": {
    "test": "deno test -A --no-check tests/unit tests/integration",
    "test:node": "node --import tsx --test-force-exit test-node.mjs",
    "test:integration": "deno test -A tests/integration",
    "test:e2e": "deno test -A tests/e2e",
    "bench": "deno bench -A tests/bench/",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/ tests/",
    "size:baseline": "node scripts/size-baseline/measure.mjs --write",
    "bench:baseline": "node scripts/bench-baseline/measure.mjs --write",
    "bench:check": "node scripts/bench-baseline/check.mjs",
    "size:check": "node scripts/size-baseline/check.mjs",
    "size": "node scripts/size-baseline/check.mjs",
    "compiler:coverage:baseline": "deno run -A scripts/compiler-coverage/measure.ts --write",
    "compiler:coverage:check": "deno run -A scripts/compiler-coverage/check.ts",
    "consumer:bundle:baseline": "node scripts/consumer-bundle/measure.mjs --write",
    "consumer:bundle:check": "node scripts/consumer-bundle/check.mjs"
  },
  "imports": {
    "@dreamer/view": "./src/mod.ts",
    "@dreamer/view/jsx-runtime": "./src/jsx-runtime.ts",
    "@dreamer/view/jsx-dev-runtime": "./src/jsx-runtime.ts",
    "@dreamer/view/compiler": "./src/compiler/mod.ts",
    "@dreamer/view/ssr": "./src/runtime/server.ts",
    "@dreamer/view/reactivity": "./src/reactivity/mod.ts",
    "@dreamer/view/scheduler": "./src/scheduler/mod.ts",
    "@dreamer/view/router": "./src/router.ts",
    "@dreamer/view/form": "./src/form.ts",
    "@dreamer/view/resource": "./src/resource.ts",
    "@dreamer/view/control-flow": "./src/control-flow.ts",
    "@dreamer/view/csr": "./src/csr.ts",
    "@dreamer/view/devtools": "./src/devtools.ts",
    "@dreamer/view/devtools/overlay": "./src/devtools/overlay.ts",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/console": "jsr:@dreamer/console@^1.1.1",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.4.0",
    "@dreamer/server": "jsr:@dreamer/server@^1.3.0",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.1.0",
    "@dreamer/service": "jsr:@dreamer/service@^1.1.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.2.0",
    "typescript": "npm:typescript@5.9.3",
    "happy-dom": "npm:happy-dom@20.4.0",
    "cssnano": "npm:cssnano@7.0.3"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "0",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view",
    "lib": [
      "deno.ns",
      "deno.window",
      "dom"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any",
        "no-namespace"
      ]
    }
  },
  "exclude": [
    "dist/",
    "tests/data/"
  ],
  "workspace": [
    "examples"
  ]
}
