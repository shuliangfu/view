{
  "name": "@dreamer/view",
  "version": "2.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Lightweight reactive view engine with signals and effects; fine-grained DOM updates without virtual DOM. Supports CSR, SSR, streaming SSR, and hydration. JSX with v-if, v-once, v-cloak and store, router, context.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuliangfu/view.git"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./cli": "./src/cli.ts",
    "./setup": "./src/setup.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./compiler": "./src/compiler/mod.ts",
    "./optimize": "./src/optimize.ts",
    "./ssr": "./src/runtime/server.ts",
    "./portal": "./src/runtime/portal.ts",
    "./reactivity": "./src/reactivity/mod.ts",
    "./scheduler": "./src/scheduler/mod.ts",
    "./router": "./src/router.ts",
    "./form": "./src/form.ts",
    "./resource": "./src/resource.ts",
    "./control-flow": "./src/control-flow.ts",
    "./csr": "./src/csr.ts",
    "./devtools": "./src/devtools.ts",
    "./devtools/overlay": "./src/devtools/overlay.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "bun test --preload ./tests/unit/dom-setup.ts tests/",
    "test:node": "node --import tsx --test-force-exit test-node.mjs",
    "build": "deno run -A build.ts"
  },
  "dependencies": {
    "@dreamer/console": "npm:@jsr/dreamer__console@^1.1.0",
    "@dreamer/esbuild": "npm:@jsr/dreamer__esbuild@^1.3.0",
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@^1.1.2",
    "@dreamer/image": "npm:@jsr/dreamer__image@^1.1.0",
    "@dreamer/logger": "npm:@jsr/dreamer__logger@^1.1.0",
    "@dreamer/plugin": "npm:@jsr/dreamer__plugin@^1.1.0",
    "@dreamer/plugins": "npm:@jsr/dreamer__plugins@^1.2.0",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.2.2",
    "@dreamer/server": "npm:@jsr/dreamer__server@^1.3.0",
    "@dreamer/service": "npm:@jsr/dreamer__service@^1.1.0",
    "autoprefixer": "npm:autoprefixer@10.4.19",
    "happy-dom": "npm:happy-dom@20.4.0",
    "typescript": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.2.3",
    "tsx": "npm:tsx@^4.19.2"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "keywords": [
    "view",
    "reactive",
    "jsx",
    "dreamer"
  ]
}
